# ADAdev Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Key (Required for AI features - server-side only)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# GitHub Token (Optional - for higher rate limits)
GITHUB_TOKEN=your_github_token_here

# Plain API Key (Required for Find Developer widget)
VITE_PLAIN_API_KEY=your_plain_api_key_here

# Environment
NODE_ENV=production

# Port (optional, defaults to 3000)
PORT=3000

# Security: CORS Origins (comma-separated for production)
CORS_ORIGINS=https://adadev.io,https://www.adadev.io

# Security: Rate Limiting
MAX_REQUESTS_PER_HOUR=60
MIN_REQUEST_INTERVAL=1000

# Supabase Configuration (Required for activity data persistence)
# Frontend variables (for client-side)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend variables (for server-side)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here 